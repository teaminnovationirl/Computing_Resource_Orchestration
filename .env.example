# Every variable app/config.py reads, set to its default (plan section 3.3).
# config.py reads the process environment; a variable that is not set keeps
# the default shown here. Changing a proposal default needs a decision line
# in docs/decisions.md.

# Proposals, except CAPACITY_PROFILE=s0, which comes from S0.
DATABASE_URL=postgresql://orch_app:orch@localhost:5432/orch
# Tests and scripts only.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DATA_DIR=./data
# docker, or fake in tests.
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=judge-c:1
# none, simulated or nvidia.
GPU_MODE=none
# s0 or host.
CAPACITY_PROFILE=s0

# Baseline.
ADMISSION_CYCLE_S=0.5
STARVATION_GUARD_S=60
HEARTBEAT_S=2
LOST_AFTER_S=6
SWEEP_S=1
MAX_RETRIES=2
STOP_GRACE_S=2
PIDS_LIMIT=64
DEFAULT_POLICY=fcfs

# Proposals.
TOKEN_TTL_S=28800
SOURCE_MAX_BYTES=65536
# python_ml uploads: one .py or one .zip (D-85).
PYTHON_ML_UPLOAD_MAX_BYTES=1073741824
# Declared by the zip's entries.
PYTHON_ML_UNZIPPED_MAX_BYTES=4294967296
PYTHON_ML_MAX_ENTRIES=10000
# Per test case.
OUTPUT_CAP_BYTES=65536
COMPILE_TIMEOUT_S=10
STOP_CONFIRM_TIMEOUT_S=10
DB_POOL_MIN=4
DB_POOL_MAX=40
# Host MemAvailable as a percentage of MemTotal.
HEALTH_MIN_AVAILABLE_PCT=10
